---
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  const books = Object.values(
    import.meta.glob('../../data/books/*.json', {
      eager: true,
      import: 'default'
    })
  );

  return books.map((book) => ({
    params: { slug: book.slug },
    props: { book }
  }));
}

const { book } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${book.title} / ${book.titleZh}`} description={book.description}>
  <div class="reader-page">
    <a class="back-link" href={base}>← BACK TO LIBRARY</a>
    <section class="book-detail-hero">
      <div class="detail-cover">
        <div class="cover cover-amber detail-cover-inner">
          <div class="cover-topline">AI READING ATLAS <span>001</span></div>
          <div class="cover-graphic"><span></span><i></i><b></b></div>
          <div class="cover-title">{book.title.split(':')[0].toUpperCase()}</div>
          <div class="cover-chinese">{book.titleZh}</div>
          <div class="cover-bottom">{book.category.toUpperCase()} · BILINGUAL EDITION</div>
        </div>
      </div>
      <div class="detail-copy">
        <div class="eyebrow"><span class="eyebrow-line"></span> {book.category.toUpperCase()} · {book.year}</div>
        <h1>{book.title}<br/><em>{book.titleZh}</em></h1>
        <p class="detail-subtitle">{book.subtitle}</p>
        <p class="detail-subtitle zh">{book.subtitleZh}</p>
        <div class="detail-description">{book.description}<br/><span>{book.descriptionZh}</span></div>
        <div class="detail-facts">
          <div><small>AUTHOR</small><strong>{book.author}</strong></div>
          <div><small>READING TIME</small><strong>{book.readingTime}</strong></div>
          <div><small>LEVEL</small><strong>{book.level}</strong></div>
        </div>
        <div class="detail-actions">
          <a class="button button-dark" href="#reading">Start reading <span>↓</span></a>
          <span class="ai-badge">✳ AI-ASSISTED ORIGINAL</span>
        </div>
      </div>
    </section>

    <section class="chapter-section" id="reading">
      <div class="chapter-heading">
        <div><div class="eyebrow"><span class="eyebrow-line"></span> INSIDE THE BOOK</div><h2>{book.chapters.length} chapters.<br/><em>Ideas worth exploring.</em></h2></div>
        <div class="chapter-count">CONTENTS <strong>{String(book.chapters.length).padStart(2, '0')}</strong></div>
      </div>
      <div class="chapter-list">
        {book.chapters.map((chapter) => (
          <a class="chapter-row" href={`#chapter-${chapter.number}`}>
            <span class="chapter-number">{chapter.number}</span>
            <span class="chapter-name">{chapter.title}<small>{chapter.titleZh}</small></span>
            <span class="chapter-arrow">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="reading-area">
      <div class="reading-toolbar">
        <div><span class="reading-live-dot"></span> READING ROOM <span class="toolbar-divider">/</span> {book.title.toUpperCase()}</div>
        <div class="reading-controls">
          <div class="mode-switch" role="group" aria-label="Reading language">
            <button data-mode="bilingual" class="selected">双语</button>
            <button data-mode="en">EN</button>
            <button data-mode="zh">中文</button>
          </div>
          <button class="font-button" id="font-down" aria-label="Decrease font size">A−</button>
          <button class="font-button" id="font-up" aria-label="Increase font size">A+</button>
        </div>
      </div>
      <div class="reading-progress"><span id="progress-bar"></span></div>
      <div class="reading-content" id="reading-content">
        {book.chapters.map((chapter) => (
          <article class="chapter" id={`chapter-${chapter.number}`}>
            <div class="chapter-overline">CHAPTER {chapter.number} <span>✳</span></div>
            <h2>{chapter.title}</h2>
            <h3>{chapter.titleZh}</h3>
            {chapter.paragraphs.map((paragraph) => (
              <div class="reading-pair">
                <p class="english">{paragraph.en}</p>
                <p class="chinese">{paragraph.zh}</p>
              </div>
            ))}
          </article>
        ))}
        <div class="end-of-book"><span>✳</span><p>THE END</p><small>感谢阅读 · Thank you for reading</small></div>
      </div>
    </section>
  </div>
  <script is:inline define:vars={{ slug: book.slug }}>
    const reader = document.getElementById('reading-content');
    const modeButtons = document.querySelectorAll('[data-mode]');
    modeButtons.forEach(button => button.addEventListener('click', () => {
      modeButtons.forEach(item => item.classList.remove('selected'));
      button.classList.add('selected');
      reader.dataset.mode = button.dataset.mode;
      localStorage.setItem('ara-mode', button.dataset.mode);
    }));
    const savedMode = localStorage.getItem('ara-mode');
    if (savedMode) {
      reader.dataset.mode = savedMode;
      modeButtons.forEach(item => item.classList.toggle('selected', item.dataset.mode === savedMode));
    }
    let fontSize = Number(localStorage.getItem('ara-font-size') || 18);
    const applyFont = () => {
      reader.style.setProperty('--reader-font-size', fontSize + 'px');
      localStorage.setItem('ara-font-size', fontSize);
    };
    document.getElementById('font-down').addEventListener('click', () => { fontSize = Math.max(15, fontSize - 1); applyFont(); });
    document.getElementById('font-up').addEventListener('click', () => { fontSize = Math.min(25, fontSize + 1); applyFont(); });
    applyFont();

    const progressKey = 'ara-progress-' + slug;
    const progressBar = document.getElementById('progress-bar');
    const savedProgress = Number(localStorage.getItem(progressKey) || 0);
    if (savedProgress > 0) window.scrollTo(0, savedProgress);
    const updateProgress = () => {
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const value = max > 0 ? Math.min(100, Math.max(0, window.scrollY / max * 100)) : 0;
      progressBar.style.width = value + '%';
      localStorage.setItem(progressKey, Math.round(window.scrollY));
    };
    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  </script>
</BaseLayout>
