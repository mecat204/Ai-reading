---
import BaseLayout from '../layouts/BaseLayout.astro';
const books = Object.values(import.meta.glob('../data/books/*.json', { eager: true, import: 'default' })).sort((a, b) => a.slug.localeCompare(b.slug));
const featuredBook = books.find((item) => item.slug === 'the-last-library') ?? books[0];
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Discover" description="Discover original bilingual stories and ideas.">
  <section class="hero">
    <div class="hero-copy">
      <div class="eyebrow"><span class="eyebrow-line"></span> THE NEW WAY TO READ</div>
      <h1>Stories are<br /><em>universes.</em></h1>
      <p class="hero-intro">A growing library of original ideas, thoughtful stories, and bilingual reading experiences — made for curious minds.</p>
      <div class="hero-buttons">
        <a class="button button-dark" href={`${base}books/${featuredBook.slug}/`}>Explore the library <span>↗</span></a>
        <a class="text-link" href="#library">Discover stories <span>↓</span></a>
      </div>
      <div class="hero-note"><span class="note-dot"></span> ORIGINAL WORKS · ENGLISH & 中文</div>
    </div>
    <div class="hero-art" aria-label="Abstract book cover illustration">
      <div class="art-orbit orbit-one"></div>
      <div class="art-orbit orbit-two"></div>
      <div class="art-sun"></div>
      <div class="art-book">
        <div class="book-spine"></div>
        <div class="book-kicker">A STORY FOR TOMORROW</div>
        <div class="book-title">THE LAST<br/><i>LIBRARY</i></div>
        <div class="book-rule"></div>
        <div class="book-author">AI READING ATLAS STUDIO</div>
        <div class="book-number">01 / 04</div>
      </div>
      <div class="art-caption caption-top">FIG. 001 — A PLACE TO BEGIN</div>
      <div class="art-caption caption-bottom">READ · REFLECT · DISCOVER</div>
    </div>
  </section>

  <section class="manifesto">
    <div class="manifesto-label">01 / OUR IDEA</div>
    <p>Not just another library.<br/><span>A space where language meets imagination.</span></p>
    <div class="manifesto-aside">Read in your language.<br/>Think beyond it.</div>
  </section>

  <section class="library-section" id="library">
    <div class="section-heading">
      <div>
        <div class="eyebrow"><span class="eyebrow-line"></span> THE COLLECTION</div>
        <h2>Open a new <em>chapter.</em></h2>
      </div>
      <div class="collection-count"><strong>{String(books.length).padStart(2, '0')}</strong><span>BOOKS IN<br/>THE COLLECTION</span></div>
    </div>
    <div class="collection-toolbar">
      <span>SELECTED STORIES <b>—</b> 2026</span>
      <label class="search-box"><span>⌕</span><input id="book-search" type="search" placeholder="Find a story..." aria-label="Search books" /></label>
    </div>
    <div class="book-grid" id="book-grid">
      {books.map((book, index) => (
        <article class="book-card" data-search={`${book.title} ${book.titleZh} ${book.category} ${book.categoryZh} ${book.description} ${book.descriptionZh}`.toLowerCase()}>
          <a class="cover-link" href={`${base}books/${book.slug}/`} aria-label={`Read ${book.title}`}>
            <div class={`cover ${book.cover || 'cover-amber'}`}>
              <div class="cover-topline">AI READING ATLAS <span>{String(index + 1).padStart(3, '0')}</span></div>
              <div class="cover-graphic"><span></span><i></i><b></b></div>
              <div class="cover-title">{book.title.split(':')[0].toUpperCase()}</div>
              <div class="cover-chinese">{book.titleZh}</div>
              <div class="cover-bottom">{book.category.toUpperCase()} · BILINGUAL EDITION</div>
            </div>
            <span class="cover-open">OPEN BOOK ↗</span>
          </a>
          <div class="card-meta"><span>{String(index + 1).padStart(2, '0')} — {book.category.toUpperCase()}</span><span>{book.readingTime.toUpperCase()}</span></div>
          <h3><a href={`${base}books/${book.slug}/`}>{book.title}</a></h3>
          <div class="card-title-zh">{book.titleZh}</div>
          <p>{book.description}</p>
          <div class="card-bottom"><span>ENGLISH <b>+</b> 中文</span><a href={`${base}books/${book.slug}/`}>READ BOOK ↗</a></div>
        </article>
      ))}
      <div class="coming-card">
        <div class="coming-symbol">✳</div>
        <div class="coming-label">THE COLLECTION IS GROWING</div>
        <h3>More worlds<br/><em>are on their way.</em></h3>
        <p>New original stories, fresh perspectives, and more languages will find a home here.</p>
        <span class="coming-index">NEXT CHAPTER — SOON</span>
      </div>
    </div>
    <div class="empty-state" id="empty-state" hidden>No stories found. Try another search.</div>
  </section>
  <section class="bottom-quote">
    <span>“</span>
    <p>A book is a door.<br/><em>Reading is how we walk through.</em></p>
    <small>THE READING ATLAS PRINCIPLE</small>
  </section>
  <script is:inline>
    const search = document.getElementById('book-search');
    const cards = [...document.querySelectorAll('.book-card')];
    const empty = document.getElementById('empty-state');
    search?.addEventListener('input', () => {
      const query = search.value.trim().toLowerCase();
      let visible = 0;
      cards.forEach(card => {
        const match = card.dataset.search.includes(query);
        card.hidden = !match;
        if (match) visible++;
      });
      empty.hidden = visible > 0 || !query;
    });
  </script>
</BaseLayout>
